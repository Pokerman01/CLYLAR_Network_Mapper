# Google Gemini API Key. A superadmin can also set it on the Settings page (saved in instance/gemini_key,
# which wins over this file). This line is the fallback.
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini model (gemini-2.5-flash or newer)
GEMINI_MODEL=gemini-2.5-flash

# Optional: online MAC vendor fallback (api.macvendors.com). OFF by default.
# Only used when nmap's offline OUI list has no match. Sends the 3-byte OUI
# (first half of the MAC) to a third party; results are cached in instance/mac_vendor_cache.json.
# MAC_LOOKUP_ONLINE=1
